# Copy this file to .env and fill in your own values. Never commit .env.

# Port the API listens on
PORT=5000

# Frontend origin(s) allowed to call this API (comma-separated, no trailing slash)
FRONTEND_ORIGIN=http://localhost:3000

# Set to 1 when running behind a hosting proxy (Render, Railway, Fly.io) so rate limits see real client IPs
# TRUST_PROXY=1

# Python executable used to extract text from PDFs (e.g. python, python3, or a venv path)
PYTHON_PATH=python

# Adzuna job search API — https://developer.adzuna.com/
ADZUNA_API_ID=your_adzuna_app_id
ADZUNA_API_KEY=your_adzuna_app_key
# Country code for job search (sg, gb, us, au, ...)
ADZUNA_COUNTRY=sg

# OpenAI API — https://platform.openai.com/api-keys
# Used to read resumes, rank jobs by similarity, and write cover letters
OPENAI_API_KEY=your_openai_api_key
# Optional model overrides
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_COVER_LETTER_MODEL=gpt-4o
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
