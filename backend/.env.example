# Copy this file to .env and fill in your own values. Never commit .env.

# Port the API listens on
PORT=5000

# Frontend origin(s) allowed to call this API (comma-separated, no trailing slash)
FRONTEND_ORIGIN=http://localhost:3000

# Python executable used to run the resume parser (e.g. python, python3, or a venv path)
PYTHON_PATH=python

# Adzuna job search API — https://developer.adzuna.com/
ADZUNA_API_ID=your_adzuna_app_id
ADZUNA_API_KEY=your_adzuna_app_key

# OpenAI API (used only for cover letter generation) — https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key
